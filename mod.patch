+describe("Troop upgrades (M window backend)", () => {
+  test("cost rises per level, last level is 37.5M, max 10, needs gold", async () => {
+    const g = await setup("plains", { instantBuild: true }, [
+      new PlayerInfo("a", PlayerType.Human, null, "a"),
