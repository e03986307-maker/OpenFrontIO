+  isActive(): boolean {
+    return this.active;
+  }
+
+  activeDuringSpawnPhase(): boolean {
+    return false;
+  }
+
+  snapshot(w: SnapshotWriter): ExecRecord {
+    return BunkerExecutionSnapshot.write({
+      active: this.active,
+      initialized: this.mg !== undefined,
+      bunker: w.unit(this.bunker),
